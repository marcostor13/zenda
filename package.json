{
  "name": "doogking",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build:shared": "bun run --cwd libs/shared build",
    "dev:shared": "bun run --cwd libs/shared dev",
    "dev:api": "bun run --cwd libs/shared build && bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build:api": "bun run --cwd libs/shared build && bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "test": "bun run --filter '*' test",
    "test:api": "bun run --cwd apps/api test",
    "test:web": "bun run --cwd apps/web test",
    "lint": "bun run --filter '*' lint"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
