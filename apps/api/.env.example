# ── Servidor ────────────────────────────────────────────────────────────────
# El frontend en modo dev espera el API en el puerto 3051 (ver
# apps/web/src/environments/environment.ts). Usa 3051 en local.
PORT=3051

# ── Base de datos (obligatorio) ───────────────────────────────────────────────
# Sin MONGODB_URI el API no arranca.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/zenda?retryWrites=true&w=majority

# ── Auth JWT (obligatorio) ────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-secret-seguro
JWT_EXPIRES_IN=7d

# ── Stripe (obligatorio para el flujo de pago) ────────────────────────────────
# La reserva solo pasa de 'pendiente' a 'confirmada' cuando Stripe llama al
# webhook POST /api/v1/payments/webhook. En local usa:
#   stripe listen --forward-to localhost:3051/api/v1/payments/webhook
# y copia el whsec_... que imprime en STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Subida de imágenes (opcional) ─────────────────────────────────────────────
# Fotos de listados y de la ficha de la mascota (POST /upload/image).
# SIN estas variables la subida NO falla: la imagen se guarda en MongoDB
# (GridFS) y se sirve por GET /api/v1/upload/:id. Configúralas solo si quieres
# que las imágenes vayan a S3.
S3_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Origen público de los objetos de S3 (CDN o dominio propio). Necesario si el
# bucket NO es de lectura pública: sin esto se devuelve la URL directa
# https://<bucket>.s3.<region>.amazonaws.com/... que un bucket privado
# responde con 403 y la foto no se ve. Ver DEPLOY.md.
S3_PUBLIC_BASE_URL=

# ── Búsqueda con IA / DeepSeek (opcional) ─────────────────────────────────────
# Solo se necesita para POST /ai-search. Sin la key, el buscador cae al
# formulario manual (no rompe nada).
DEEPSEEK_API_KEY=

# ── Mapas / Google Places (opcional) ──────────────────────────────────────────
# Alimenta el autocompletado de población del buscador (GET /geo/autocomplete) y
# las coordenadas de la ciudad elegida (GET /geo/geocode). La clave NUNCA llega
# al navegador: el frontend siempre pasa por este proxy. Sin ella, el campo de
# ciudad sigue funcionando como texto libre.
# Restringe la clave en Google Cloud a la API "Places API (New)".
GOOGLE_MAPS_API_KEY=

# ── URL pública de la web ─────────────────────────────────────────────────────
# Base de los enlaces que viajan en los correos (verificación de cuenta,
# valoración, recuperación de reservas).
#
# OBLIGATORIO en producción y en staging: debe ser el dominio real. Ya ocurrió
# que se desplegó con el valor de desarrollo y los correos de verificación
# salieron apuntando a localhost:4200, con lo que nadie podía activar su cuenta.
# Como red de seguridad, con NODE_ENV=production un valor local se descarta y se
# usa https://www.doogking.com (ver apps/api/src/shared/url-publica.ts), pero
# eso no sustituye a configurarla: en staging enviaría a producción.
APP_URL=http://localhost:4200

# ── URL pública del API ───────────────────────────────────────────────────────
# Base de los callbacks de OAuth de calendario. Debe coincidir exactamente con
# la URI de redirección registrada en Google Cloud y en Azure.
API_URL=http://localhost:3000

# ── Sincronización de agenda (opcional) ───────────────────────────────────────
# Sin estas credenciales la agenda funciona igual (jornadas, bloqueos, huecos);
# lo único que no se puede hacer es conectar un calendario externo.
#
# Google Cloud → API "Google Calendar API", credencial OAuth 2.0 de tipo
# "Aplicación web", con la URI de redirección {API_URL}/agenda/oauth/google
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Azure → registro de aplicación, permiso delegado Calendars.ReadWrite,
# URI de redirección {API_URL}/agenda/oauth/microsoft
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# ── Notificaciones push (opcional) ────────────────────────────────────────────
# El registro de dispositivos funciona siempre; sin esta clave el envío se omite
# en silencio y el aviso llega solo por email e in-app.
# Firebase Console → Configuración del proyecto → Cloud Messaging → clave de servidor.
FCM_SERVER_KEY=

# ── Email transaccional / SMTP (opcional) ─────────────────────────────────────
# Confirmación de reserva al cliente + alerta de nueva reserva al comercio,
# tras el webhook de pago aprobado. Sin SMTP_HOST el API arranca igual; el
# intento de envío queda registrado como 'fallido' en la colección
# 'notificaciones' (outbox) en vez de perderse.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Doogking <no-reply@doogking.eu>
