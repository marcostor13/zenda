# ─────────────────────────────────────────────────────────────────────────────
# Configuración de la WEB (Angular). Copiar a `apps/web/.env` para desarrollo.
# En producción se declaran como variables de entorno del servicio en Coolify:
# el contenedor las escribe en `env.js` al arrancar, así que cambiar una es
# reiniciar el servicio, no reconstruir la imagen.
#
# ⚠️ TODO LO QUE ESTÉ AQUÍ ES PÚBLICO. La web es una SPA: el navegador se
# descarga estos valores y cualquiera puede leerlos. Esto evita tenerlos escritos
# en el repositorio y permite cambiarlos por entorno, pero NO los oculta.
#
# Por eso sólo se publican las variables con prefijo `WEB_`. Las claves de
# servidor —GOOGLE_MAPS_API_KEY, STRIPE_SECRET_KEY, MONGODB_URI— viven en el
# servicio del API y nunca deben declararse con este prefijo.
# ─────────────────────────────────────────────────────────────────────────────

# Base del API, con el prefijo de versión incluido.
WEB_API_URL=http://localhost:3051/api/v1

# Pantalla "muy pronto" antes del lanzamiento público. `true` la activa.
# Con ella activa se entra con ?acceso=<WEB_UNDER_CONSTRUCTION_KEY>.
WEB_UNDER_CONSTRUCTION=false
WEB_UNDER_CONSTRUCTION_KEY=royal-preview-2026

# Clave PUBLICABLE de Stripe (pk_test_… o pk_live_…). La secreta va en el API.
WEB_STRIPE_PUBLIC_KEY=

# Login social: identificadores públicos de cliente. Si quedan vacíos, los
# botones sociales no se muestran y la app sigue funcionando con email.
WEB_GOOGLE_CLIENT_ID=
WEB_FACEBOOK_APP_ID=
