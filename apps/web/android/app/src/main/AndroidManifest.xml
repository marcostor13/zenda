<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Enlaces profundos: un enlace a doogking.com abre la app en la
                pantalla correspondiente en vez del navegador. `autoVerify`
                exige publicar assetlinks.json en el dominio (ver DEPLOY-MOVIL.md);
                sin él Android ofrece elegir app, que sigue funcionando.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="doogking.com" />
                <data android:scheme="https" android:host="www.doogking.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!--
            Icono y color de las notificaciones push. Sin declararlos, Android
            usa el icono de la app: en la barra de estado se ve un cuadrado
            gris, porque ahí sólo se respeta la silueta.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_doogking" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/doogking_notificacion" />
        <!-- Debe coincidir con el canal que crea la app al arrancar. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="doogking-avisos" />
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Desde Android 13 (API 33) las notificaciones se piden en tiempo de
        ejecución; sin este permiso el sistema las descarta en silencio y no
        hay forma de saber por qué no llegan.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        "Cerca de mí" del buscador (alojamiento y explora) llama a
        `navigator.geolocation`. El WebView no puede concederlo por su cuenta:
        sin estos permisos la llamada falla en silencio y el botón no hace nada.
        Coarse basta para ordenar resultados por distancia; Fine se pide porque
        Android exige declararlo para que Coarse ofrezca "ubicación precisa".
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
        Subida de fotos (ficha de comercio, incidencias de reserva, seguros). El
        selector del WebView ofrece "hacer foto", y sin CAMERA esa opción se
        cierra sola al elegirla.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Lectura de la galería. Desde Android 13 el permiso de imágenes es
        granular; en versiones anteriores sigue siendo READ_EXTERNAL_STORAGE, de
        ahí el `maxSdkVersion` (declararlo sin tope lo rechaza Play).
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        La cámara es opcional: sin esto Play oculta la app en tablets y
        dispositivos sin cámara, que pueden usarla perfectamente.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
        Android 11+ filtra qué otras apps se pueden ver. Sin declararlo, abrir
        un enlace externo, el correo de soporte o el marcador desde la ficha de
        un comercio no encuentra ninguna app y no ocurre nada.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
</manifest>
